# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Supabase project (Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Edge Functions) — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sibling teams' endpoints
FITSOLVER_URL=https://fitsolver.example.com/optimize
FITVISUALIZER_URL=https://fitvisualizer.example.com/render
